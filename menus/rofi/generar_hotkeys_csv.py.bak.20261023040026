#!/usr/bin/env python3
"""
Genera ~/.config/hotkeys/hotkeys.csv con hotkeys/aliases de:
  - AwesomeWM (rc.lua + keys_second_brain.lua)
  - Zsh aliases (~/.zsh_aliases)
  - Zsh bindkeys (~/.zshrc sección TECLAS)
  - Zellij (~/.config/zellij/config.kdl)

Re-ejecutar preserva la columna 'enabled' editada por el usuario.
"""

import csv, re
from pathlib import Path

HOME     = Path.home()
CSV_PATH = HOME / '.config/hotkeys/hotkeys.csv'
FIELDS   = ['enabled', 'source', 'key', 'description', 'action']


# ── Parsers ────────────────────────────────────────────────────────────────────

def parse_awesome(path):
    entries = []
    try:
        text = Path(path).read_text()
    except FileNotFoundError:
        return entries

    text = re.sub(r'^\s*--.*$', '', text, flags=re.MULTILINE)

    pat = re.compile(
        r'awful\.key\(\s*\{([^}]*)\}\s*,\s*"([^"]+)"\s*,.*?'
        r'description\s*=\s*"([^"]+)".*?group\s*=\s*"([^"]+)"',
        re.DOTALL
    )
    for m in pat.finditer(text):
        mods_raw, key, desc, group = m.groups()
        mods = []
        if 'Mod4'    in mods_raw or 'modkey' in mods_raw: mods.append('Super')
        if 'altkey'  in mods_raw or '"Alt"'  in mods_raw: mods.append('Alt')
        if '"Shift"'   in mods_raw: mods.append('Shift')
        if '"Control"' in mods_raw: mods.append('Ctrl')
        combo = '+'.join(mods + [key]) if mods else key
        source = f'awesomewm/{group}'
        entries.append({'source': source, 'key': combo,
                        'description': desc, 'action': ''})
    return entries


def parse_aliases(path):
    entries = []
    comment = ''
    try:
        lines = Path(path).read_text().splitlines()
    except FileNotFoundError:
        return entries

    for line in lines:
        s = line.strip()
        if s.startswith('#'):
            c = s.lstrip('#').strip()
            comment = '' if '---' in c else c
        elif m := re.match(r"alias\s+([^=\s]+)\s*=\s*['\"](.+)['\"]$", s):
            name, cmd = m.group(1), m.group(2)
            entries.append({'source': 'zsh/alias', 'key': name,
                            'description': comment or name, 'action': cmd})
            comment = ''
        else:
            if s:
                comment = ''
    return entries


def parse_bindkeys(path):
    entries = []
    try:
        content = Path(path).read_text()
    except FileNotFoundError:
        return entries

    sec = re.search(r'# --- TECLAS ---(.+?)# ---', content, re.DOTALL)
    if not sec:
        return entries

    seen = set()
    for m in re.finditer(
        r'bindkey\s+-M\s+emacs\s+"([^"]+)"\s+(\S+)\s+#\s*(.+)',
        sec.group(1)
    ):
        seq, widget, desc = m.group(1), m.group(2), m.group(3).strip()
        if seq not in seen:
            seen.add(seq)
            entries.append({'source': 'zsh/key', 'key': seq,
                            'description': desc, 'action': widget})
    return entries


def parse_zellij(path):
    entries = []
    MODES = {'normal','locked','resize','pane','move','tab',
             'scroll','search','session','tmux'}
    try:
        lines = Path(path).read_text().splitlines()
    except FileNotFoundError:
        return entries

    mode = 'normal'
    for line in lines:
        stripped = line.strip()
        if m := re.match(r'^(\w+)\s*\{', stripped):
            if m.group(1) in MODES:
                mode = m.group(1)
        if '//' in stripped and stripped.index('//') < (stripped.find('bind') if 'bind' in stripped else 9999):
            continue
        if m := re.search(r'bind\s+"([^"]+)"[^{]*\{([^}]+)\}', stripped):
            action = re.sub(r'\s+', ' ', m.group(2).strip().rstrip(';'))
            entries.append({'source': f'zellij/{mode}', 'key': m.group(1),
                            'description': action, 'action': action})
    return entries


# ── Merge & write ──────────────────────────────────────────────────────────────

def load_enabled(path):
    """(source, key) → enabled, para preservar ediciones del usuario."""
    if not path.exists():
        return {}
    with open(path, newline='') as f:
        return {(r['source'], r['key']): r['enabled']
                for r in csv.DictReader(f)}


def write(entries, existing):
    CSV_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(CSV_PATH, 'w', newline='') as f:
        w = csv.DictWriter(f, fieldnames=FIELDS)
        w.writeheader()
        for e in entries:
            e['enabled'] = existing.get((e['source'], e['key']), '1')
            w.writerow(e)


# ── Main ───────────────────────────────────────────────────────────────────────

def main():
    cfg = HOME / '.config/awesome'
    entries = (
        parse_awesome(cfg / 'rc.lua') +
        parse_awesome(cfg / 'keys_second_brain.lua') +
        parse_aliases(HOME / '.zsh_aliases') +
        parse_bindkeys(HOME / '.zshrc') +
        parse_zellij(HOME / '.config/zellij/config.kdl')
    )
    existing = load_enabled(CSV_PATH)
    write(entries, existing)
    disabled = sum(1 for v in existing.values() if v == '0')
    print(f"✓ {CSV_PATH}")
    print(f"  {len(entries)} entradas  |  {disabled} deshabilitadas preservadas")


if __name__ == '__main__':
    main()
