MIX_PATH = "/mnt/windows/Mix"
MIXXX_DB = os.path.expanduser("~/.mixxx/mixxxdb.sqlite")
MUSIC_DB = os.environ.get("MFUZZ_DB", os.path.expanduser("~/gits/pollo/music-fuzzy/db/sqlite/musica_local.sqlite"))
BACKUP_DIR = os.path.expanduser("~/.mixxx/backups_fecha_original")
