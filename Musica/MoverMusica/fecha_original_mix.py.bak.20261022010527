EasyID3.RegisterTXXXKey("releasedate", "RELEASEDATE")


def norm(s):
    return re.sub(r"\W+", "", (s or "").lower())


def loose(s):
    """Para comparar con MusicBrainz: sin acentos ni puntuación"""
    s = unicodedata.normalize("NFKD", s or "").encode("ascii", "ignore").decode()
    return re.sub(r"\W+", "", s.lower())


def loose_artist(s):
    """Además, «&» = «and» y sin artículo delante: «El Aviador Dro» = «Aviador Dro»,
    «Martha Reeves and the Vandellas» = «Martha Reeves & The Vandellas»"""
    s = re.sub(r"\s*&\s*", " and ", (s or "").lower())
    s = re.sub(r"^(the|el|la|los|las|le|les|die|der|das|il|i)\s+", "", s.strip())
    return loose(s)


def year_of(date):
    m = re.match(r"\s*(\d{4})", date or "")
    return int(m.group(1)) if m and m.group(1) != "0000" else None


def first(tags, key):
    v = tags.get(key)
    return (v[0] if isinstance(v, list) else v) if v else ""


def song_key(tags):
    return f"{norm(first(tags, 'artist'))}|{norm(first(tags, 'title'))}"


def load_json(path):
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        return {}


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


class ReleaseDates:
    """Fechas de primer lanzamiento de la base de datos de música"""

    def __init__(self, path):
        self.by_rg = {}
        self.by_name = collections.defaultdict(list)  # (artista, título) -> [(fecha, tipo)]
        if not path or not os.path.exists(path):
            print(f"⚠️  No encuentro la base de datos de música ({path}): solo uso los tags", file=sys.stderr)
            return
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        for mbid, date in db.execute(
                "SELECT mbid, first_release_date FROM mb_release_group WHERE first_release_date != ''"):
            self.by_rg[mbid] = date
        for mbid, title, date, rtype, artist in db.execute(
                "SELECT md.mbid, md.title, md.first_release_date, md.release_type, a.name "
                "FROM musicbrainz_discography md JOIN artists a ON a.id = md.artist_id "
                "WHERE md.first_release_date != ''"):
            self.by_rg.setdefault(mbid, date)
            self.by_name[(norm(artist), norm(title))].append((date, (rtype or "").lower()))
        db.close()

    def candidates(self, tags):
        artist = first(tags, "artist")
        rg = first(tags, "musicbrainz_releasegroupid")
        found = []
        if rg in self.by_rg:
            found.append((self.by_rg[rg], "BD álbum"))
        elif not rg:
            # Sin ID solo queda el nombre del álbum (menos fiable: álbumes homónimos)
            for date, _ in self.by_name.get((norm(artist), norm(first(tags, "album"))), []):
                found.append((date, "BD álbum (nombre)"))
        for date, rtype in self.by_name.get((norm(artist), norm(first(tags, "title"))), []):
            if rtype in ("single", "ep"):
                found.append((date, f"BD {rtype}"))
        return found


class MusicBrainz:
    """Consultas a MusicBrainz (1 por segundo, con caché en disco)"""

    def __init__(self, offline=False, force=False):
        self.offline = offline
        self.force = force
        self.fresh = set()  # consultado en esta ejecución (con --force no se repite)
        self.last = 0.0
        self.failures = 0  # fallos de conexión seguidos
        try:
            self.cache = json.load(open(CACHE_FILE))
        except (OSError, ValueError):
            self.cache = {}

    def stale(self, key):
        """Hay que consultarlo: no está en caché, o --force y aún no se ha consultado en esta ejecución"""
        return key not in self.cache or (self.force and key not in self.fresh)

    def save(self):
        """Mezcla con lo que haya en disco: otra ejecución a la vez (p. ej. mover_mix_playerctl) no se pisa"""
        os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
        try:
            disk = json.load(open(CACHE_FILE))
        except (OSError, ValueError):
            disk = {}
        disk.update(self.cache)
        self.cache = disk
        tmp = f"{CACHE_FILE}.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump(self.cache, f)
        os.replace(tmp, CACHE_FILE)

    def _get(self, path, params):
        wait = 1.05 - (time.time() - self.last)
        if wait > 0:
            time.sleep(wait)
        for attempt in range(3):
            self.last = time.time()
            try:
                r = requests.get(f"{MB_API}/{path}", params={**params, "fmt": "json"},
                                 headers=MB_HEADERS, timeout=20)
                if r.status_code == 404:
                    self.failures = 0
                    return {}
                if r.status_code == 503:
                    time.sleep(2 + attempt * 2)
                    continue
                r.raise_for_status()
                self.failures = 0
                return r.json()
            except requests.ConnectionError as e:
                # Conexión rechazada/cortada: reintentar no sirve de mucho
                self.failures += 1
                print(f"    ⚠️  MusicBrainz no responde: {type(e).__name__}", file=sys.stderr, flush=True)
                if self.failures >= 5:
                    print("    ⚠️  MusicBrainz no responde: sigo sin él "
                          "(vuelve a ejecutar más tarde para completar)", file=sys.stderr, flush=True)
                    self.offline = True
                return None
            except requests.RequestException as e:
                print(f"    ⚠️  MusicBrainz: {e}", file=sys.stderr, flush=True)
                time.sleep(2)
        return None

    def recording_date(self, recording_id):
        key = f"rec:{recording_id}"
        if self.stale(key):
            if self.offline:
                return self.cache.get(key, "")
            data = self._get(f"recording/{recording_id}", {})
            if data is None:
                return self.cache.get(key, "")  # sin tocar la caché: se reintenta la próxima vez
            self.cache[key] = data.get("first-release-date") or ""
            self.cache[f"url:{key}"] = f"https://musicbrainz.org/recording/{recording_id}"
            self.fresh.add(key)
        return self.cache[key]

    def search_date(self, artist, title):
        """Fecha más antigua entre las grabaciones con el mismo artista y título exactos"""
        # search2: compara artista y título con loose()/loose_artist() (las de search: eran exactas)
        key = f"search2:{norm(artist)}|{norm(title)}"
        if self.stale(key):
            if self.offline:
                return self.cache.get(key, "")
            query = f'recording:"{lucene(title)}" AND artist:"{lucene(artist)}"'
            data = self._get("recording", {"query": query, "limit": 50})
            if data is None:
                return self.cache.get(key, "")
            dates = []  # (fecha, id de la grabación)
            for rec in data.get("recordings", []):
                credit = "".join(c.get("name", "") + c.get("joinphrase", "")
                                 for c in rec.get("artist-credit", []))
                if loose(rec.get("title")) == loose(title) and loose_artist(credit) == loose_artist(artist):
                    if year_of(rec.get("first-release-date")):
                        dates.append((rec["first-release-date"], rec["id"]))
            best = min(dates, key=lambda d: year_of(d[0])) if dates else ("", "")
            self.cache[key] = best[0]
            self.cache[f"url:{key}"] = f"https://musicbrainz.org/recording/{best[1]}" if best[1] else ""
            self.fresh.add(key)
        return self.cache[key]

    def keys(self, tags):
        """Claves de caché de esta canción (para sacar sus enlaces)"""
        rid, artist, title = first(tags, "musicbrainz_trackid"), first(tags, "artist"), first(tags, "title")
        return ([f"rec:{rid}"] if rid else []) + ([f"search2:{norm(artist)}|{norm(title)}"] if artist and title else [])

    def candidates(self, tags):
        found = []
        recording_id = first(tags, "musicbrainz_trackid")
        if recording_id:
            date = self.recording_date(recording_id)
            if date:
                found.append((date, "MusicBrainz grabación"))
        artist, title = first(tags, "artist"), first(tags, "title")
        if artist and title:
            date = self.search_date(artist, title)
            if date:
                found.append((date, "MusicBrainz búsqueda"))
        return found


# Paréntesis que cambian la grabación (remezcla, directo…): no se quitan al buscar, que el original es de otro año.
VERSION = re.compile(r"remix|rework|re-?edit|\bedit\b|\bdub\b|\bvip\b|\blive\b|en directo|acoustic|ac[uú]stic|"
                     r"instrumental|\bdemo\b|\bmix\b|version|versi[oó]n|cover", re.I)
# …salvo estas, que son la misma grabación.
SAME = re.compile(r"original mix|radio edit|single version|album version|remaster|\bmono\b|\bstereo\b|"
                  r"\d+\W? ?(?:inch|version)|extended|lp version", re.I)


def strip_brackets(title):
    """Título sin los paréntesis que no cambian la grabación: «Erghen Diado (Song Of Schopsko)» → «Erghen Diado»,
    «Shadows (Original Mix)» → «Shadows», pero «Parola (Rework)» se queda igual"""
    def drop(m):
        inner = m.group(0)
        return inner if VERSION.search(inner) and not SAME.search(inner) else ""
    return re.sub(r"\s*[(\[][^)\]]*[)\]]", drop, title).strip() or title


class Discogs:
    """Búsqueda en Discogs por artista + canción (1 consulta por segundo, en la misma caché que MusicBrainz)"""

    def __init__(self, mb):
        self.mb = mb  # comparte caché, --offline y --force
        self.last = 0.0
        self.token = os.environ.get("DISCOGS_TOKEN", "")
        if not self.token and os.path.exists(DISCOGS_ENV):
            for line in open(DISCOGS_ENV):
                k, sep, v = line.strip().partition("=")
                if sep and k.strip() == "DISCOGS_TOKEN":
                    self.token = v.strip().strip("\"'")
        if not self.token:
            print("⚠️  Sin DISCOGS_TOKEN: sigo solo con MusicBrainz", file=sys.stderr)

    def _search(self, **params):
        """Lista de resultados, o None si Discogs no responde"""
        for attempt in range(3):
            wait = 1.05 - (time.time() - self.last)
            if wait > 0:
                time.sleep(wait)
            self.last = time.time()
            try:
                r = requests.get(DISCOGS_API, params={**params, "per_page": 100}, timeout=20,
                                 headers={"User-Agent": MB_HEADERS["User-Agent"],
                                          "Authorization": f"Discogs token={self.token}"})
                if r.status_code == 429:  # límite por minuto
                    time.sleep(10 + attempt * 10)
                    continue
                r.raise_for_status()
                return r.json().get("results", [])
            except requests.RequestException as e:
                print(f"    ⚠️  Discogs: {e}", file=sys.stderr, flush=True)
                time.sleep(2)
        return None

    @staticmethod
    def variants(artist, title):
        """Formas de escribirlo. Primero el título sin paréntesis: «Erghen Diado (Song Of Schopsko)» solo
        sale en la reedición de 1986; «Erghen Diado», también en el original de 1975"""
        t = re.sub(r"[’'`]", "", title)
        short = strip_brackets(t)
        main = re.split(r"\s+(?:&|and|y|feat\.?|ft\.?|featuring|with|vs\.?|x)\s+|,\s*", artist, flags=re.I)[0].strip()
        out = []
        for a in dict.fromkeys([artist, main]):
            for tt in dict.fromkeys([short, t]):
                out.append((a, tt))
        return out

    def date(self, artist, title):
        key = f"discogs:{norm(artist)}|{norm(title)}"
        if not self.token or not self.mb.stale(key):
            return self.mb.cache.get(key, "")
        if self.mb.offline:
            return self.mb.cache.get(key, "")
        years = []  # (año, uri)
        for a, t in self.variants(artist, title):
            for kind in ("master", "release"):
                res = self._search(artist=a, track=t, type=kind)
                if res is None:
                    return self.mb.cache.get(key, "")  # sin tocar la caché: se reintenta la próxima vez
                years = [(int(x["year"]), x.get("uri", "")) for x in res
                         if str(x.get("year", "")).isdigit() and int(x["year"]) > 1900
                         and "Unofficial Release" not in x.get("format", [])]
                if years:
                    break
            if years:
                break
        best = min(years) if years else (0, "")
        self.mb.cache[key] = str(best[0]) if best[0] else ""
        self.mb.cache[f"url:{key}"] = f"https://www.discogs.com{best[1]}" if best[1] else ""
        self.mb.fresh.add(key)
        return self.mb.cache[key]

    def keys(self, tags):
        return [f"discogs:{norm(first(tags, 'artist'))}|{norm(first(tags, 'title'))}"]

    def candidates(self, tags):
        artist, title = first(tags, "artist"), first(tags, "title")
        if not (artist and title):
            return []
        date = self.date(artist, title)
        return [(date, "Discogs")] if date else []


def lucene(s):
    return re.sub(r'([+\-&|!(){}\[\]^"~*?:\\/])', r"\\\1", s)


def original_date(tags, releases, mb, discogs, decisions=None):
    """Devolver (fecha_original, fuente, dudosa) o ('', '', None) si no hay nada.
    dudosa: {"mb": fecha, "dg": fecha} si MusicBrainz y Discogs discrepan en más de DUDOSO años"""
    if decisions and song_key(tags) in decisions:
        # Elegida al revisar; "" = dejar la que tiene
        return decisions[song_key(tags)] or first(tags, "date"), "decisión", None
    originals = [(first(tags, k), k.upper()) for k in ("originaldate", "originalyear")]
    originals += releases.candidates(tags)
    # Siempre: en un recopilatorio o remaster las fechas anteriores son las de ese disco
    from_mb = [(d, s) for d, s in mb.candidates(tags) if year_of(d)]
    from_dg = [(d, s) for d, s in discogs.candidates(tags) if year_of(d)]
    originals = [(d, s) for d, s in originals + from_mb + from_dg if year_of(d)]
    candidates = [(d, s) for d, s in [(first(tags, "date"), "DATE")] + originals if year_of(d)]
    if not candidates:
        return "", "", None
    doubt = None
    if from_mb and from_dg:
        d_mb = min(from_mb, key=lambda c: year_of(c[0]))[0]
        if abs(year_of(d_mb) - year_of(from_dg[0][0])) > DUDOSO:
            doubt = {"mb": d_mb, "dg": from_dg[0][0]}
    date, source = min(candidates, key=lambda c: (year_of(c[0]), c[1] != "DATE"))
    return date, source, doubt


def mixxx_running():
    return subprocess.run(["pgrep", "-x", "mixxx"], capture_output=True).returncode == 0


def iter_files(targets):
    for target in targets:
        if os.path.isdir(target):
            for root, _, files in os.walk(target):
                for f in sorted(files):
                    if f.lower().endswith(EXTS):
                        yield os.path.join(root, f)
        elif target.lower().endswith(EXTS):
            yield target


def review(mb, discogs):
    """Repasar las fechas dudosas una a una y guardar lo elegido en DECISIONES_FILE"""
    pending = load_json(DUDOSOS_FILE)
    decisions = load_json(DECISIONES_FILE)
    todo = [d for d in pending.values() if d["key"] not in decisions and os.path.exists(d["path"])]
    if not todo:
        print("No hay fechas dudosas por revisar." if pending else
              "No hay fechas dudosas apuntadas: ejecuta antes la simulación (sin opciones).")
        return
    todo.sort(key=lambda d: d["path"])
    print(f"{len(todo)} fechas dudosas. Para cada una: m = MusicBrainz, d = Discogs, k = dejar la actual,\n"
          "un año o fecha (1966, 1966-10) = esa, s = saltar, q = salir. Lo elegido se guarda al momento.\n")
    for n, d in enumerate(todo, 1):
        tags = File(d["path"], easy=True).tags
        # Enlaces: lo consultado antes de que la caché los guardara se vuelve a pedir (2-3 consultas)
        keys = mb.keys(tags) + discogs.keys(tags)
        if any(f"url:{k}" not in mb.cache for k in keys) and not mb.offline:
            mb.force, mb.fresh = True, set()
            mb.candidates(tags)
            discogs.candidates(tags)
            mb.force = False
            mb.save()
        url = lambda k: mb.cache.get(f"url:{k}", "")
        mb_links = [url(k) for k in mb.keys(tags) if url(k)]
        dg_link = url(discogs.keys(tags)[0])
        print(f"[{n}/{len(todo)}] {first(tags, 'artist')} — {first(tags, 'title')}")
        print(f"   disco:        {first(tags, 'album') or '—'}")
        print(f"   archivo:      {os.path.relpath(d['path'], MIX_PATH)}")
        print(f"   ahora:        {first(tags, 'date') or '—'}")
        print(f"   MusicBrainz:  {d['mb']:<11} {'  '.join(dict.fromkeys(mb_links))}")
        print(f"   Discogs:      {d['dg']:<11} {dg_link}")
        while True:
            try:
                a = input("   ¿Fecha? [m/d/k/año/s/q] ").strip().lower()
            except EOFError:
                a = "q"
            if a == "q":
                print(f"\nGuardadas en {DECISIONES_FILE}. Con Mixxx cerrado, --apply --offline las escribe.")
                return
            if a == "s":
                break
            choice = {"m": d["mb"], "d": d["dg"], "k": ""}.get(a, a if re.fullmatch(r"\d{4}(-\d\d){0,2}", a) else None)
            if choice is None:
                print("   m, d, k, un año (1966) o fecha (1966-10), s o q")
                continue
            decisions[d["key"]] = choice
            save_json(DECISIONES_FILE, decisions)
            print(f"   → {choice or 'se queda ' + (first(tags, 'date') or '—')}\n")
            break
    print(f"Revisadas. Guardadas en {DECISIONES_FILE}. Con Mixxx cerrado, --apply --offline las escribe.")


def main():
    ap = argparse.ArgumentParser(description="Poner a las canciones de Mix su fecha de lanzamiento original")
    ap.add_argument("paths", nargs="*", help=f"archivos o carpetas (por defecto {MIX_PATH})")
    ap.add_argument("--apply", action="store_true", help="escribir los cambios (sin esto, solo simula)")
    ap.add_argument("--offline", action="store_true",
                    help="no consultar MusicBrainz ni Discogs (solo tags, base de datos y caché)")
    ap.add_argument("--force", action="store_true",
                    help="volver a consultar en MusicBrainz y Discogs todas las fechas, aunque estén en caché")
    ap.add_argument("--solo-archivo", action="store_true",
                    help="con --apply, escribir solo los tags sin tocar la base de datos de Mixxx (para canciones "
                         "que Mixxx aún no tiene, como las recién copiadas; vale con Mixxx abierto)")
    ap.add_argument("--dudosos", action="store_true",
                    help="con --apply, escribir también las fechas dudosas (MusicBrainz y Discogs no coinciden)")
    ap.add_argument("--revisar", action="store_true",
                    help="repasar las fechas dudosas con sus enlaces y elegir (se guarda como decisión)")
    ap.add_argument("--quiet", action="store_true", help="solo el resumen")
    args = ap.parse_args()

    if args.revisar:
        mb = MusicBrainz(offline=args.offline)
        try:
            review(mb, Discogs(mb))
        except KeyboardInterrupt:
            print(f"\nInterrumpido. Lo elegido está en {DECISIONES_FILE}.")
        finally:
            mb.save()
        return

    update_mixxx = args.apply and not args.solo_archivo and os.path.exists(MIXXX_DB)
    if update_mixxx and mixxx_running():
        sys.exit("Mixxx está abierto: ciérralo antes de usar --apply (hay que actualizar también su base de datos).\n"
                 "Con Mixxx abierto se puede simular (sin --apply): consulta y guarda en caché; luego, con Mixxx\n"
                 "cerrado, --apply --offline escribe lo calculado sin volver a consultar.")

    releases = ReleaseDates(MUSIC_DB)
    if args.force and args.offline:
        sys.exit("--force y --offline no van juntos: --force vuelve a consultar MusicBrainz.")
    mb = MusicBrainz(offline=args.offline, force=args.force)
    discogs = Discogs(mb)
    files = list(iter_files(args.paths or [MIX_PATH]))
    decisions = load_json(DECISIONES_FILE)
    pending = load_json(DUDOSOS_FILE)  # dudosas por ruta; las de los archivos de esta ejecución se recalculan
    changes = []
    doubtful = []
    errors = 0
    try:
        for i, path in enumerate(files, 1):
            if i % 50 == 0:
                mb.save()
            try:
                audio = File(path, easy=True)
                if audio is None:
                    continue
                if audio.tags is None:
                    audio.add_tags()
                current = first(audio.tags, "date")
                pending.pop(path, None)
                new, source, doubt = original_date(audio.tags, releases, mb, discogs, decisions)
                if source == "decisión":
                    if not new or new == current:  # la decisión puede retrasar la fecha
                        continue
                elif not new or (year_of(current) and year_of(new) >= year_of(current)):
                    continue
                line = f"{current or '—':>10} → {new:<10} [{source}]  {os.path.relpath(path, MIX_PATH)}"
                if doubt and not args.dudosos:
                    note = f"MusicBrainz {doubt['mb']}, Discogs {doubt['dg']}"
                    doubtful.append(f"{line}  ({note})")
                    pending[path] = {"path": path, "key": song_key(audio.tags), "current": current, **doubt}
                    if not args.quiet:
                        print(f"⚠️ DUDOSA {line}  ({note})", flush=True)
                    continue
                changes.append((path, current, new, source))
                if not args.quiet:
                    print(line, flush=True)
                if args.apply:
                    if current and not first(audio.tags, "releasedate"):
                        audio.tags["releasedate"] = current
                    audio.tags["date"] = new
                    audio.save()
            except Exception as e:
                errors += 1
                print(f"⚠️  {path}: {e}", file=sys.stderr)
    except KeyboardInterrupt:
        print("\nInterrumpido (lo consultado queda en caché).", file=sys.stderr)
        if args.apply and changes:
            print("Los archivos ya cambiados se reflejan también en Mixxx.", file=sys.stderr)
    finally:
        mb.save()
        save_json(DUDOSOS_FILE, pending)

    if update_mixxx and changes:
        os.makedirs(BACKUP_DIR, exist_ok=True)
        backup = os.path.join(BACKUP_DIR, time.strftime("mixxxdb.%Y%m%d%H%M%S.sqlite"))
        shutil.copy2(MIXXX_DB, backup)
        db = sqlite3.connect(MIXXX_DB, timeout=10)
        with db:
            db.executemany(
                "UPDATE library SET year = ? WHERE location IN (SELECT id FROM track_locations WHERE location = ?)",
                [(new, path) for path, _, new, _ in changes])
        db.close()
        print(f"Base de datos de Mixxx actualizada (copia en {backup})")

    verb = "cambiadas" if args.apply else ("a cambiar (simulación; con Mixxx cerrado, --apply --offline "
                                           "las escribe usando lo guardado en caché)")
    print(f"\n{len(changes)} de {len(files)} canciones {verb}" + (f", {errors} errores" if errors else ""))
    if doubtful:
        print(f"{len(doubtful)} fechas dudosas sin escribir (MusicBrainz y Discogs discrepan en más de {DUDOSO} años).\n"
              "Revísalas con enlaces y elige una a una: fecha_original_mix.py --revisar")


if __name__ == "__main__":
    main()
